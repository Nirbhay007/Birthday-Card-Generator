{
  "name": "birthday-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:worker": "NEXT_PRIVATE_STANDALONE=true npm run build && opennextjs-cloudflare build --skipNextBuild",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:worker && opennextjs-cloudflare deploy",
    "deploy:dev": "NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_TZESihLNLuI8VW npm run build:worker && opennextjs-cloudflare deploy -e dev",
    "start": "next start",
    "lint": "eslint",
    "analytics": "node scripts/analytics.js",
    "qa": "node qa/run.js",
    "qa:test": "playwright test",
    "qa:ui": "node qa/run.js --ui",
    "qa:headed": "node qa/run.js --headed",
    "qa:smoke": "node qa/run.js --grep @smoke",
    "qa:critical": "node qa/run.js --grep @critical",
    "qa:razorpay": "node qa/run.js e2e/razorpay.spec.js --project=chromium",
    "qa:setup": "node qa/run.js --setup-only",
    "qa:report": "playwright show-report",
    "qa:db": "docker compose -f qa/docker-compose.yml up -d --wait --wait-timeout 120",
    "qa:db:stop": "docker compose -f qa/docker-compose.yml down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "^5.22.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.15.0",
    "heic-to": "^1.5.2",
    "lucide-react": "^0.554.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "railway": "^3.11.0",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^14.3.8",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.11.24",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "wrangler": "^4.156.0"
  }
}