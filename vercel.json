{
    "crons": [
        {
            "path": "/api/cron/cleanup",
            "schedule": "0 4 * * *"
        }
    ],
    "functions": {
        "src/app/api/upload/route.js": {
            "memory": 1024,
            "maxDuration": 30
        },
        "src/app/api/cron/cleanup/route.js": {
            "memory": 512,
            "maxDuration": 30
        },
        "src/app/api/**": {
            "memory": 512
        }
    }
}