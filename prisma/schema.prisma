// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL") //  Accelerate for the app (pooling & caching)
  directUrl = env("POSTGRES_URL")       //  Direct connection for migrations
}

model BirthdayPage {
  id           String   @id @default(cuid())
  // Ownership secret (192-bit hex). Required to edit the card via PATCH.
  // Nullable: cards created before this column exist stay editable (legacy).
  editToken    String?  @unique
  recipientName String
  birthdayDate DateTime?
  message      String?
  theme        String   @default("elegant")
  audioEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  ipAddress    String?
  reminderEmail String?
  age          Int?
  senderName   String?
  relationship String?
  music        String?  @default("classic")
  viewCount    Int      @default(0)
  loves        Int      @default(0)
  shares       Int      @default(0)
  source       String?
  isVip        Boolean  @default(false)
  isVipPro     Boolean  @default(false)
  photos       Photo[]
}

model Photo {
  id        String       @id @default(cuid())
  url       String
  order     Int          @default(0)
  pageId    String
  page      BirthdayPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Postgres does not index foreign keys automatically; photo joins/cleanup
  // filter by pageId and grow one row per uploaded photo.
  @@index([pageId])
}

// Donation-funnel analytics (append-only, no PII).
// New standalone table — existing tables are untouched by its migration.
model SupportEvent {
  id        String   @id @default(cuid())
  event     String   // 'modal_open' | 'pay_click' | 'copy_upi'
  amount    Int?     // selected rupee amount (pay_click only)
  path      String?  // page path that drove the click, e.g. '/wishes/mom'
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}

// Premium payment receipts (append-only). Created when a Razorpay order is
// made, marked paid after signature verification. Standalone table —
// additive migration only, existing data untouched.
model PremiumOrder {
  id        String    @id @default(cuid())
  provider  String    @default("razorpay")
  orderId   String    @unique // Razorpay order id, e.g. 'order_...'
  paymentId String?   // Razorpay payment id, filled on success
  amount    Int       // smallest currency unit (paise / cents)
  currency  String    // 'INR' | 'USD'
  status    String    @default("created") // 'created' | 'paid' | 'failed'
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  pageId    String?   // Linked BirthdayPage id for card VIP upgrades
  tier      String?   @default("universe") // 'card_vip' | 'universe'
  // Magic-link token: unlock_<random>. Whoever opens /premium?...&key=<token>
  // is treated as the payer — no accounts needed. Shareable by design
  // (giver pays, recipient opens), unguessable (192-bit random + DB check).
  unlockToken String?  @unique
  // Full URL snapshot (e.g. /premium?to=Ahmad&from=...&key=unlock_...) for support recovery.
  snapshotUrl  String?
  // Buyer phone/email from Razorpay — for support outreach without checking the dashboard.
  buyerContact String?

  @@index([status, createdAt])
  @@index([pageId])
}

// Append-only share intents (ADDITIVE ONLY). One row per real share action,
// written at the moment it happens so analytics can group by event time
// instead of by the card's creation date.
//
// `BirthdayPage.shares` remains the lifetime counter and is still incremented
// alongside the event. Dedupe is per (pageId, channel, sessionId) within a
// short window, so double-clicks and repeat channel clicks don't inflate it,
// while sharing to a different channel still counts.
model ShareEvent {
  id        String   @id @default(cuid())
  pageId    String
  channel   String // 'whatsapp' | 'telegram' | 'facebook' | 'x' | 'copy' | 'native' | 'other'
  source    String   @default("card_footer") // 'post_creation' | 'creator_notice' | 'card_footer'
  sessionId String? // random per-tab-session id used only for dedupe (no PII)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([pageId, channel, sessionId, createdAt])
}
