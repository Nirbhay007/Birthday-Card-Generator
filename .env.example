# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Runtime URL. Production uses a Prisma Accelerate URL:
#   prisma+postgres://accelerate.prisma-data.net/?api_key=...
# Preview and local development can use a direct Postgres URL instead; the
# build runs the standard `prisma generate`, so both work.
PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=REPLACE_ME"

# Direct PostgreSQL connection, used by Prisma for migrations.
POSTGRES_URL="postgres://user:password@host:5432/database"

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://birthday.example.com"
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
NEXT_PUBLIC_DEMO_VIDEO_URL=""

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Razorpay (payments)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="BirthdayGen <hello@example.com>"
EMAIL_REPLY_TO=""
EMAIL_TOKEN_SECRET=""
ALERT_FROM_EMAIL=""
ALERT_TO_EMAIL=""

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Cloudflare R2 — primary storage for photos and music. Existing cards depend
# on these values, so keep the same bucket/domain when migrating hosts.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="birthday-card-assets"
R2_PUBLIC_DOMAIN="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# Vercel Blob — fallback storage and direct uploads over 4MB.
# Created automatically when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Optional analytics / monetization
# ---------------------------------------------------------------------------
STATS_TOKEN=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ENABLE_ADS=""
NEXT_PUBLIC_ENABLE_AFFILIATE=""
NEXT_PUBLIC_ENABLE_PRO_TIER=""
NEXT_PUBLIC_ADSENSE_ID=""
